{
  "name": "andrew-portfolio-example",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write app src scripts docs *.md *.json *.mjs *.ts",
    "format:check": "prettier --check app src scripts docs *.md *.json *.mjs *.ts",
    "lint": "eslint app src scripts --max-warnings=0",
    "test:architecture": "CHOKIDAR_USEPOLLING=1 steiger --fail-on-warnings src",
    "check:project": "npm run format:check && npm run lint && npm run test:architecture && npm run typecheck",
    "check": "npm run check:project && npm run build"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "prettier": "^3.9.5",
    "steiger": "^0.5.13",
    "@feature-sliced/steiger-plugin": "^0.6.0"
  }
}
